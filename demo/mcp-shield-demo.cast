[3.4000000000000012, "o", "\r\n\r\n"]
[3.9000000000000012, "o", "MCP Shield: demo/vulnerable_server.py \u2014 7 finding(s)\r\n"]
[3.9800000000000013, "o", "\r\n"]
[4.060000000000001, "o", "  [CRIT] SSRF-01: Potential SSRF: Dynamic URL from user input\r\n"]
[4.460000000000002, "o", "    requests call with dynamic URL that may include user input\r\n"]
[4.540000000000002, "o", "    Location: demo/vulnerable_server.py:10\r\n"]
[4.620000000000002, "o", "    Fix: Validate URL against an allowlist of permitted hosts/schemes. Block internal IPs (127.0.0.1, 169.254.x.x, 10.x.x.x).\r\n"]
[4.700000000000002, "o", "    CWE: CWE-918\r\n"]
[4.780000000000002, "o", "\r\n"]
[4.860000000000002, "o", "  [CRIT] INJ-01: Code injection: eval/exec usage\r\n"]
[5.2600000000000025, "o", "    eval() or exec() found. If input is user-controllable, this is RCE.\r\n"]
[5.3400000000000025, "o", "    Location: demo/vulnerable_server.py:21\r\n"]
[5.420000000000003, "o", "    Fix: Remove eval/exec entirely. Use json.loads() for data parsing, ast.literal_eval() for Python literals only.\r\n"]
[5.500000000000003, "o", "    CWE: CWE-94\r\n"]
[5.580000000000003, "o", "\r\n"]
[5.660000000000003, "o", "  [CRIT] INJ-05: Unsafe deserialization: pickle\r\n"]
[6.060000000000003, "o", "    pickle.load() on untrusted data allows arbitrary code execution\r\n"]
[6.140000000000003, "o", "    Location: demo/vulnerable_server.py:32\r\n"]
[6.220000000000003, "o", "    Fix: Never unpickle untrusted data. Use json.loads() for data exchange.\r\n"]
[6.300000000000003, "o", "    CWE: CWE-502\r\n"]
[6.3800000000000034, "o", "\r\n"]
[6.4600000000000035, "o", "  [HIGH] INJ-03: Command injection: subprocess with shell=True\r\n"]
[6.860000000000004, "o", "    subprocess called with shell=True. User input in args = RCE.\r\n"]
[6.940000000000004, "o", "    Location: demo/vulnerable_server.py:26\r\n"]
[7.020000000000004, "o", "    Fix: Use subprocess with shell=False (default) and pass args as a list.\r\n"]
[7.100000000000004, "o", "    CWE: CWE-78\r\n"]
[7.180000000000004, "o", "\r\n"]
[7.260000000000004, "o", "  [HIGH] SEC-01: SSL verification disabled\r\n"]
[7.660000000000005, "o", "    HTTP request with verify=False disables certificate validation\r\n"]
[7.740000000000005, "o", "    Location: demo/vulnerable_server.py:10\r\n"]
[7.820000000000005, "o", "    Fix: Remove verify=False. Fix the underlying certificate issue instead.\r\n"]
[7.900000000000005, "o", "    CWE: CWE-295\r\n"]
[7.980000000000005, "o", "\r\n"]
[8.060000000000004, "o", "  [MED] PATH-02: No path traversal protection detected\r\n"]
[8.460000000000004, "o", "    File operations found but no realpath/resolve validation or '..' rejection\r\n"]
[8.540000000000004, "o", "    Location: demo/vulnerable_server.py\r\n"]
[8.620000000000005, "o", "    Fix: Add os.path.realpath() validation on all file paths from external input.\r\n"]
[8.700000000000005, "o", "    CWE: CWE-22\r\n"]
[8.780000000000005, "o", "\r\n"]
[8.860000000000005, "o", "  [MED] PATH-03: Symlink following without check\r\n"]
[9.260000000000005, "o", "    File operations on user-provided paths without symlink detection\r\n"]
[9.340000000000005, "o", "    Location: demo/vulnerable_server.py\r\n"]
[9.420000000000005, "o", "    Fix: Use os.path.realpath() to resolve symlinks, then verify the resolved path is within the allowed directory.\r\n"]
[9.500000000000005, "o", "    CWE: CWE-59\r\n"]
[9.580000000000005, "o", "\r\n"]
[9.660000000000005, "o", "Grade: F | 3 critical, 2 high, 2 medium\r\n"]
[10.460000000000006, "o", "\r\n"]
[11.540000000000006, "o", "\r\n  Scan complete. Protect your AI agents.\r\n"]
